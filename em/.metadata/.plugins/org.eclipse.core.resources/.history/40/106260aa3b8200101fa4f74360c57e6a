package patternn;

public class patternn {

			public static void main(String[] args) {
				
					int n=4;
					int a=6;
					for( int i=1;i<=n;i++)
					{
					    for(int j=1;j<=a;j++)
					    {
					        System.out.print("*");
					    }
					    System.out.println();
					}
					}
				

		}


	

